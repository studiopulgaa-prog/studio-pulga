{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/orcamento", "dest": "/public/orcamento.html" },
    { "src": "/index.html", "dest": "/public/index.html" },
    { "src": "/orcamento.html", "dest": "/public/orcamento.html" },
    { "src": "/(.*\\.(webp|png|jpg|svg|ico|css|js))", "dest": "/public/$1" }
  ]
}
